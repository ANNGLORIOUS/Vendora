generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id               Int      @id @default(autoincrement())
  name             String
  contactPerson    String?
  phone            String
  location         String?
  status           String   @default("Active")
  totalOrders      Int      @default(0)
  totalPaid        Int      @default(0)
  outstandingBalance Int    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]
}

model Order {
  id             Int      @id @default(autoincrement())
  customerId     Int?
  customerName   String
  contactPerson  String?
  orderDate      DateTime @default(now())
  meatType       String
  quantity       Int
  unitPrice      Int
  totalAmount    Int
  amountPaid     Int      @default(0)
  balance        Int      @default(0)
  paymentStatus  String   @default("Outstanding")
  orderStatus    String   @default("Pending")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer? @relation(fields: [customerId], references: [id])
  payments       Payment[]
}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  customerName String
  amount      Int
  paymentDate DateTime @default(now())
  method      String   @default("Mpesa")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id])
}

model CowPurchase {
  id             Int      @id @default(autoincrement())
  purchaseDate   DateTime @default(now())
  seller         String
  cowCount       Int
  purchasePrice  Int
  totalCost      Int
  weightKg       Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BusinessSetting {
  id                  Int      @id @default(autoincrement())
  businessName        String
  businessEmail       String
  businessPhone       String
  businessAddress     String
  defaultCurrency     String   @default("KES")
  reminderThresholdDays Int     @default(7)
  invoicePrefix       String   @default("VND")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
